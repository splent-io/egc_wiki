WORKING_DIR=/workspace
SPLENT_APP=egc_wiki
PYTHONPATH=/workspace/egc_wiki/src
FLASK_APP=egc_wiki:create_app

MARIADB_HOSTNAME=egc_wiki_db
MARIADB_DATABASE=egc_wiki_db
MARIADB_TEST_DATABASE=egc_wiki_db_test
MARIADB_USER=egc_wiki_db_user
MARIADB_PASSWORD=egc_wiki_db_password
MARIADB_ROOT_PASSWORD=egc_wiki_db_root_password

RUN_DB_SEED=true

# ── The subject this wiki serves ────────────────────────────────────────
COURSES_NAME_PREFIX=EGC
COURSES_DESCRIPTION_TEMPLATE=Material docente de EGC, curso {year}
COURSES_DEFAULT_CATEGORIES=Teoría,Prácticas,Organización,Elementos evaluables y cálculo de nota
# The frozen archive of the wiki this replaces, served read only.
ARCHIVE_PATH=archivo
ARCHIVE_DIR=/workspace/egc_wiki/archive
